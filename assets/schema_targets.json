{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/clinical-genomics-uppsala/ampliton/main/assets/schema_targets.json",
    "title": "ampliton pipeline - params.targets schema",
    "description": "Schema for the file provided with params.targets",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "target": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Target name must be provided and cannot contain spaces",
                "meta": [
                    "target"
                ]
            },
            "FW_primer": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Forward primer sequence must be provided and cannot contain spaces",
                "meta": [
                    "FW_primer"
                ]
            },
            "RV_primer": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Reverse primer sequence must be provided and cannot contain spaces",
                "meta": [
                    "RV_primer"
                ]
            },
            "min_length": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "Minimum length must be an integer of length >1",
                "meta": [
                    "min_length"
                ]
            },
            "max_length": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "Maximum length must be an integer of length >1",
                "meta": [
                    "max_length"
                ]
            },
            "analysis": {
                "type": "string",
                "enum": [
                    "ASV",
                    "COUNT",
                    "MLST",
                    "SPA"
                ],
                "default": "ASV",
                "errorMessage": "Analysis must be either of ASV, COUNT, MLST or SPA",
                "meta": [
                    "analysis"
                ]
            }
        },
        "required": [
            "target",
            "FW_primer",
            "RV_primer"
        ]
    }
}