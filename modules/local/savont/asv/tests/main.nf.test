nextflow_process {

    name "Test Process SAVONT_ASV"
    script "../main.nf"
    process "SAVONT_ASV"

    tag "modules"
    tag "modules_"
    tag "savont"
    tag "savont/asv"

    test("saureus - fastq") {

        when {
            process {
                """                
                input[0] = [
                    [ id:'test' , min_length:'200', max_length:'700'],
                    file(params.testdata_base_path + 'SA1704249_260706_clean_100.fastq.gz', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.fasta,
                    process.out.feature_table,
                    process.out.final_assignments,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert path(process.out.log[0][1]).exists() },
                { assert path(process.out.log[0][1]).text.contains('SAVONT COMPLETED SUCCESSFULLY') }
            )
        }

    }

    test("saureus - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', min_length:'200', max_length:'700' ],
                    file(params.testdata_base_path + 'SA1704249_260706_clean_100.fastq.gz', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
