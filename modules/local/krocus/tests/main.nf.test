nextflow_process {

    name "Test Process KROCUS"
    script "../main.nf"
    process "KROCUS"

    tag "modules"
    tag "modules_"
    tag "krocus"

    test("saureus - fastq") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.testdata_base_path + 'SA1704249_260706_clean_100.fastq.gz', checkIfExists: true),
                ]
                input[1] = channel.value(file(params.testdata_base_path + 'krocus/Staphylococcus_aureus', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("saureus - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.testdata_base_path + 'SA1704249_260706_clean_100.fastq.gz', checkIfExists: true),
                ]
                input[1] = channel.value(file(params.testdata_base_path + 'krocus/Staphylococcus_aureus', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
